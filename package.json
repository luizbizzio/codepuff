{
  "name": "codepuff",
  "version": "0.1.0",
  "description": "An interactive coding pet for Claude Code and OpenAI Codex.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Luiz Bizzio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luizbizzio/codepuff.git"
  },
  "bin": {
    "codepuff": "bin/codepuff.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src",
    "hooks",
    "assets",
    "types",
    "codex",
    ".claude-plugin",
    ".codex-plugin",
    ".agents",
    "docs",
    "NOTICE",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node scripts/test.mjs",
    "bench": "node scripts/bench.mjs",
    "preview": "node scripts/preview.mjs",
    "check:mod": "claude plugin validate . && claude plugin test .",
    "art:hashes": "node scripts/art-hashes.mjs",
    "fuzz": "node scripts/fuzz.mjs"
  },
  "keywords": [
    "claude-code",
    "codex",
    "pet",
    "mascot",
    "hooks",
    "statistics"
  ]
}
