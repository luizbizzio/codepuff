{
  "description": "CodePuff observes Codex lifecycle events so your pet can react. It records counters only (never prompts, code, commands or outputs) and answers {} to every event.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"(async()=>{try{const p=require('node:path'),u=require('node:url'),r=process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT;process.argv.splice(1,0,'codepuff','hook','codex');await import(u.pathToFileURL(p.join(r,'bin','codepuff.js')).href)}catch{process.stdout.write('{}')}})()\"",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
